# ==============================================================================
# n8n Local Docker Configuration
# ==============================================================================

# Port to expose on your host machine
N8N_PORT=5678

# Hostname and protocol
N8N_HOST=localhost
N8N_PROTOCOL=http

# Webhook URL:
# For local browser testing: http://localhost:5678/
# If testing external webhooks (e.g. Telegram callback, public webhooks via ngrok/localtunnel/cloudflared):
# Set this to your tunnel URL, e.g. https://xxxx.ngrok-free.app/
WEBHOOK_URL=http://localhost:5678/

# Timezone settings
GENERIC_TIMEZONE=Asia/Dhaka
TZ=Asia/Dhaka

# Optional: Fixed encryption key for credentials encryption.
# If left blank, n8n generates a key in the persistent volume automatically.
# N8N_ENCRYPTION_KEY=your-random-32-character-encryption-key
TELEGRAM_CHAT_ID=your_chat_id
